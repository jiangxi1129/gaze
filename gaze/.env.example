# 复制成 .env 然后填值。三个 caption provider 至少配一个。
# .env 千万别提交到 git（已在 .gitignore）

# ─── caption provider API keys（按优先级选一个填）──────────────────

# 智谱 GLM-4V-Flash（推荐：现在免费，注册后给 25M tokens 永久额度）
# https://open.bigmodel.cn/
GLM_API_KEY=

# 阿里 Qwen-VL-Plus（兜底，更稳但收费）
# https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=

# 字节豆包 doubao-vision-pro（备选）
# https://console.volcengine.com/ark
ARK_API_KEY=

# ─── VPS 推送配置（如果没 VPS / 只想跑离线，把这块留空 + 启动加 --no-push）──

# SSH host alias（已在 ~/.ssh/config 配好的 host 名字）
GAZE_SSH_HOST=your-vps

# VPS 上 push_caption.py 的绝对路径
GAZE_VPS_SCRIPT=/root/mcp-memory-server/push_caption.py

# VPS 上接收高清快照的路径（AI 调 gaze_snap_now() 时读这个文件）
GAZE_VPS_SNAP_PATH=/tmp/gaze_latest.jpg
